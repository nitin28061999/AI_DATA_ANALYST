      "source": [
        "### Step 1: Write your Streamlit code to `app.py`\n",
        "We use the `%%writefile app.py` magic command to save the complete application script so the server can run it."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "cc5d32a7",
        "outputId": "962c07a9-c65f-428b-bdf0-c3d3727b3ffa"
      },
      "source": [
        "%%writefile app.py\n",
        "try:\n",
        "    import google.generativeai as genai\n",
        "except ModuleNotFoundError:\n",
        "    import subprocess\n",
        "    import sys\n",
        "    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"google-generativeai\", \"-q\"])\n",
        "    import google.generativeai as genai\n",
        "\n",
        "import streamlit as st\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import os\n",
        "\n",
        "# Page Configuration\n",
        "st.set_page_config(\n",
        "    page_title=\"Tech Salary Predictor & AI Consultant\",\n",
        "    page_icon=\"💼\",\n",
        "    layout=\"wide\"\n",
        ")\n",
        "\n",
        "# App Title & Overview\n",
        "st.title(\"💼 Tech Salary Predictor & AI Career Consultant\")\n",
        "st.markdown(\"\"\"\n",
        "Explore salary trends across major tech roles, company sizes, and locations using the Glassdoor dataset.\n",
        "Interact with the predictive filters below or consult our **Gemini-powered AI Career Assistant** for personalized salary negotiation advice!\n",
        "\"\"\")\n",
        "\n",
        "# Load and Cache Data\n",
        "@st.cache_data\n",
        "def load_data():\n",
        "    df = pd.read_csv('/content/drive/MyDrive/glassdoor_jobs.csv')\n",
        "    df_clean = df[df['Salary Estimate'] != '-1'].copy()\n",
        "\n",
        "    import re\n",
        "    def parse_salary_row(row):\n",
        "        text = row['Salary Estimate']\n",
        "        if 'Per Hour' in text:\n",
        "            nums = re.findall(r'\\d+', text.replace(',', ''))\n",
        "            return (int(nums[0])*2000 + int(nums[1])*2000)/2 if len(nums)>=2 else int(nums[0])*2000\n",
        "        else:\n",
        "            nums = re.findall(r'\\d+', text.replace(',', ''))\n",
        "            return (int(nums[0])*1000 + int(nums[1])*1000)/2 if len(nums)>=2 else int(nums[0])*1000\n",
        "\n",
        "    df_clean['Avg_Salary'] = df_clean.apply(parse_salary_row, axis=1)\n",
        "    return df_clean\n",
        "\n",
        "df_clean = load_data()\n",
        "\n",
        "# Sidebar Filters\n",
        "st.sidebar.header(\"🔍 Filter Job Market Data\")\n",
        "selected_role = st.sidebar.selectbox(\"Select Job Role / Focus\", ['All', 'Data Scientist', 'Data Analyst', 'Software Engineer', 'Data Engineer'])\n",
        "selected_location = st.sidebar.selectbox(\"Select Location\", ['All'] + sorted(df_clean['Location'].unique().tolist()))\n",
        "\n",
        "# Filter Dataset\n",
        "filtered_df = df_clean.copy()\n",
        "if selected_role != 'All':\n",
        "    filtered_df = filtered_df[filtered_df['Job Title'].str.contains(selected_role, case=False, na=False)]\n",
        "if selected_location != 'All':\n",
        "    filtered_df = filtered_df[filtered_df['Location'] == selected_location]\n",
        "\n",
        "# Main Metrics Display\n",
        "col1, col2, col3 = st.columns(3)\n",
        "col1.metric(\"Matching Postings\", len(filtered_df))\n",
        "col2.metric(\"Average Salary\", f\"${filtered_df['Avg_Salary'].mean():,.0f}\" if not filtered_df.empty else \"$0\")\n",
        "col3.metric(\"Max Salary\", f\"${filtered_df['Avg_Salary'].max():,.0f}\" if not filtered_df.empty else \"$0\")\n",
        "\n",
        "# Visualizations\n",
        "st.subheader(\"📊 Market Salary Insights\")\n",
        "if not filtered_df.empty:\n",
        "    fig, ax = plt.subplots(figsize=(10, 4))\n",
        "    sns.histplot(filtered_df['Avg_Salary'], kde=True, color='teal', ax=ax, bins=20)\n",
        "    ax.set_title(f\"Salary Distribution for {selected_role} in {selected_location}\")\n",
        "    ax.set_xlabel(\"Average Annual Salary ($)\")\n",
        "    st.pyplot(fig)\n",
        "else:\n",
        "    st.warning(\"No data available for the selected combination.\")\n",
        "\n",
        "# Gemini AI Salary Negotiation Consultant\n",
        "st.markdown(\"---\")\n",
        "st.subheader(\"🤖 Gemini AI Salary Negotiation Consultant\")\n",
        "st.markdown(\"Have questions about your compensation, skill requirements, or career growth? Ask our AI assistant below!\")\n",
        "\n",
        "# Configure Gemini API\n",
        "api_key = os.getenv(\"GEMINI_API_KEY\")\n",
        "user_query = st.text_input(\"Ask a career/salary question (e.g., 'What skills should I learn to earn over $120k as a Data Scientist?'):\")\n",
        "\n",
        "if user_query:\n",
        "    if not api_key:\n",
        "        st.error(\"Gemini API Key is missing. Please configure it in your environment variables or Google Colab Secrets.\")\n",
        "    else:\n",
        "        try:\n",
        "            genai.configure(api_key=api_key)\n",
        "            model = genai.GenerativeModel('gemini-2.5-flash')\n",
        "\n",
        "            context = f\"\"\"\n",
        "            You are an expert tech career coach and salary negotiator.\n",
        "            The current dataset has {len(df_clean)} records with an overall average tech salary of ${df_clean['Avg_Salary'].mean():,.0f}.\n",
        "            User query: {user_query}\n",
        "            Provide professional, actionable, and encouraging advice.\n",
        "            \"\"\"\n",
        "\n",
        "            with st.spinner(\"Analyzing market data and generating advice... \"):\n",
        "                response = model.generate_content(context)\n",
        "                st.success(\"### AI Consultant Recommendation:\")\n",
        "                st.write(response.text)\n",
        "        except Exception as e:\n",
        "            st.error(f\"Error communicating with Gemini API: {e}\")"
      ],
      "execution_count": 13,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Writing app.py\n"
          ]
        }
      ]
    },
