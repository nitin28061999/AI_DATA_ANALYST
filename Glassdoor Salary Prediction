        "# Filter out invalid salary rows\n",
        "df_clean = df[df['Salary Estimate'] != '-1'].copy()\n",
        "\n",
        "# Parse salary strings into Low, High, and Average Annual Salary\n",
        "def parse_salary_row(row):\n",
        "    text = row['Salary Estimate']\n",
        "    if 'Per Hour' in text:\n",
        "        nums = re.findall(r'\\d+', text.replace(',', ''))\n",
        "        if len(nums) >= 2:\n",
        "            low = int(nums[0]) * 2000\n",
        "            high = int(nums[1]) * 2000\n",
        "        else:\n",
        "            low = high = int(nums[0]) * 2000\n",
        "    else:\n",
        "        nums = re.findall(r'\\d+', text.replace(',', ''))\n",
        "        if len(nums) >= 2:\n",
        "            low = int(nums[0]) * 1000\n",
        "            high = int(nums[1]) * 1000\n",
        "        elif len(nums) == 1:\n",
        "            low = high = int(nums[0]) * 1000\n",
        "        else:\n",
        "            return None, None, None\n",
        "    return low, high, (low + high) / 2\n",
        "\n",
        "salaries = df_clean.apply(parse_salary_row, axis=1)\n",
        "df_clean['Salary_Low'] = [s[0] for s in salaries]\n",
        "df_clean['Salary_High'] = [s[1] for s in salaries]\n",
        "df_clean['Avg_Salary'] = [s[2] for s in salaries]\n",
        "\n",
        "# Categorize Job Titles\n",
        "def categorize_job_title(title):\n",
        "    title = title.lower()\n",
        "    if 'data scientist' in title or 'data science' in title:\n",
        "        return 'Data Scientist'\n",
        "    elif 'data analyst' in title or 'analytics' in title:\n",
        "        return 'Data Analyst'\n",
        "    elif 'software engineer' in title or 'software developer' in title:\n",
        "        return 'Software Engineer'\n",
        "    elif 'machine learning' in title or 'ml' in title or 'ai' in title:\n",
        "        return 'Machine Learning / AI'\n",
        "    elif 'research scientist' in title:\n",
        "        return 'Research Scientist'\n",
        "    elif 'data engineer' in title:\n",
        "        return 'Data Engineer'\n",
        "    else:\n",
        "        return 'Other / General'\n",
        "\n",
        "df_clean['Job_Category'] = df_clean['Job Title'].apply(categorize_job_title)\n",
        "print(df_clean['Job_Category'].value_counts())"
